{
  "info": {
    "_postman_id": "warehouse-service-collection",
    "name": "Warehouse Service API",
    "description": "Warehouse service endpoints for frontend JWT flow and internal service-key flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Frontend JWT Flow",
      "item": [
        {
          "name": "1. Create Warehouse (JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  const id = json?.data?.id;",
                  "  if (id) {",
                  "    pm.collectionVariables.set('warehouse_id', id);",
                  "    console.log('warehouse_id saved:', id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopId\": \"{{shop_id}}\",\n  \"name\": \"Main Warehouse\",\n  \"location\": \"Yangon\",\n  \"isDefault\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/warehouses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "warehouses"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Update Warehouse (JWT)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Main Warehouse Updated\",\n  \"location\": \"Hinthada\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/warehouses/{{warehouse_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "warehouses",
                "{{warehouse_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. Get Warehouse Inventory (JWT)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/warehouses/{{warehouse_id}}/inventory",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "warehouses",
                "{{warehouse_id}}",
                "inventory"
              ]
            }
          },
          "response": []
        },
        {
          "name": "4. Increase Stock (JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": \"{{warehouse_id}}\",\n  \"productId\": \"{{product_id}}\",\n  \"quantity\": 20,\n  \"referenceId\": \"manual-restock-001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/inventory/increase",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "inventory",
                "increase"
              ]
            }
          },
          "response": []
        },
        {
          "name": "5. Adjust Stock (JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": \"{{warehouse_id}}\",\n  \"productId\": \"{{product_id}}\",\n  \"quantity\": -2,\n  \"referenceId\": \"manual-adjustment-001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/inventory/adjust",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "inventory",
                "adjust"
              ]
            }
          },
          "response": []
        },
        {
          "name": "6. List Stock Movements (JWT)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/inventory/movements?warehouseId={{warehouse_id}}&productId={{product_id}}&limit=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "inventory",
                "movements"
              ],
              "query": [
                {
                  "key": "warehouseId",
                  "value": "{{warehouse_id}}"
                },
                {
                  "key": "productId",
                  "value": "{{product_id}}"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Service-to-Service Flow",
      "item": [
        {
          "name": "7. Validate Product Stock (Service Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-service-key",
                "value": "{{service_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"qty\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/products/validate-stock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "validate-stock"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5002",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "service_api_key",
      "value": "a23r_sfw32wefsasfwerwe123dsafsfver",
      "type": "string"
    },
    {
      "key": "shop_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "warehouse_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "",
      "type": "string"
    }
  ]
}
