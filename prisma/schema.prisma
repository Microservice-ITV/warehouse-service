generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Warehouse {
  id        String          @id @default(uuid())
  code      String?         @unique @map("code")
  name      String
  address   String?
  status    WarehouseStatus @default(ACTIVE)
  /// Max units this warehouse can hold. Null = unlimited (legacy rows).
  capacityUnits Int? @map("capacity_units")
  /// Warehouse manager assigned to this warehouse.
  createdBy String?
  /// Seller who created the warehouse and orders stock into it.
  sellerUserId String? @map("seller_user_id")

  stocks    InventoryStock[]
  movements InventoryMovement[]

  @@index([status])
  @@index([createdBy])
  @@index([sellerUserId])
  @@map("warehouses")
}

model InventoryStock {
  id           String   @id @default(uuid())
  warehouseId  String   @map("warehouse_id")
  productId    String   @map("product_id")
  variantId    String   @default("") @map("variant_id")
  onHandQty    Int      @default(0) @map("on_hand_qty")
  reservedQty  Int      @default(0) @map("reserved_qty")
  availableQty Int      @default(0) @map("available_qty")
  /// Seller-entered unit price; null = use the purchase order calculation.
  unitPriceOverride Decimal? @db.Decimal(12, 2) @map("unit_price_override")
  updatedAt    DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, variantId])
  @@index([productId])
  @@map("inventory_stocks")
}

model InventoryMovement {
  id            String       @id @default(uuid())
  warehouseId   String       @map("warehouse_id")
  productId     String       @map("product_id")
  variantId     String       @default("") @map("variant_id")
  movementType  MovementType @map("movement_type")
  quantity      Int
  beforeQty     Int          @map("before_qty")
  afterQty      Int          @map("after_qty")
  referenceType String?      @map("reference_type")
  referenceId   String?      @map("reference_id")
  unitCost      Decimal?     @db.Decimal(12, 2) @map("unit_cost")
  createdBy     String?      @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([productId, warehouseId])
  @@index([warehouseId, createdAt])
  @@index([movementType])
  @@index([referenceId])
  @@map("inventory_movements")
}

model OutboxEvent {
  id          String      @id @default(uuid())
  eventId     String      @unique
  event       String
  routingKey  String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int         @default(0)
  publishedAt DateTime?
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, createdAt])
  @@map("outbox_events")
}

/// Transactional outbox for purchase-domain events (GRN received, supplier returns).
model PurchaseOutboxEvent {
  id          String       @id @default(uuid())
  eventId     String       @unique @map("event_id")
  event       String
  routingKey  String       @map("routing_key")
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  publishedAt DateTime?    @map("published_at")
  error       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("purchase_outbox_events")
}

model InboxEvent {
  id            String      @id @default(uuid())
  eventId       String      @unique
  event         String
  routingKey    String?
  payload       Json
  producer      String?
  correlationId String?
  checkoutId    String?
  status        InboxStatus @default(RECEIVED)
  receivedAt    DateTime    @default(now())
  processedAt   DateTime?
  attempts      Int         @default(0)
  error         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, receivedAt])
  @@index([event])
  @@index([checkoutId])
  @@map("inbox_events")
}

model ProcessedEvent {
  id            String   @id @default(uuid())
  eventId       String   @unique
  event         String
  producer      String?
  correlationId String?
  checkoutId    String?
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([event])
  @@index([checkoutId])
  @@map("processed_events")
}

model WarehouseTransfer {
  id              String         @id @default(uuid())
  fromWarehouseId String?        @map("from_warehouse_id")
  fromSellerUserId String?       @map("from_seller_user_id")
  toWarehouseId   String         @map("to_warehouse_id")
  productId       String         @map("product_id")
  variantId       String         @default("") @map("variant_id")
  quantity        Int
  status          TransferStatus @default(PENDING)
  referenceId     String?        @map("reference_id")
  referenceType   String?        @map("reference_type")
  requestedBy     String?        @map("requested_by")
  approvalSellerUserId String?   @map("approval_seller_user_id")
  decidedBy       String?        @map("decided_by")
  decidedAt       DateTime?      @map("decided_at")
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([approvalSellerUserId])
  @@map("warehouse_transfers")
}

/// Stock a seller owns (from delivery-agent handoff or earlier warehouse orders).
model SellerStock {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  productId    String   @map("product_id")
  variantId    String   @default("") @map("variant_id")
  onHandQty    Int      @default(0) @map("on_hand_qty")
  availableQty Int      @default(0) @map("available_qty")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@map("seller_stocks")
}

model ProductSnapshot {
  id          String   @id @default(uuid())
  productId   String   @unique
  shopId      String
  categoryId  String?
  parentCategoryId   String?
  parentCategoryName String?
  parentCategorySlug String?
  slug        String?
  title       String
  description String?
  sku         String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  images      String[] @default([])
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopId])
  @@index([isActive])
  @@map("product_snapshots")
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  PURCHASE_RECEIVED
  PURCHASE_RETURNED
  SALE_ISSUED
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_RECEIVED
  INITIAL_BALANCE
}

enum TransferStatus {
  PENDING
  SELLER_APPROVED
  AWAITING_RECEIPT
  APPROVED
  REJECTED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum InboxStatus {
  RECEIVED
  PROCESSED
  FAILED
}

/// Supplier / vendor master data (purchase domain).
model Supplier {
  id          String         @id @default(uuid())
  name        String
  code        String?        @unique
  contactName String?        @map("contact_name")
  email       String?
  phone       String?
  address     String?
  paymentTerms String?       @map("payment_terms")
  taxNumber   String?        @map("tax_number")
  currency    String         @default("USD")
  status      SupplierStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  purchaseOrders  PurchaseOrder[]
  purchaseReturns PurchaseReturn[]

  @@index([status])
  @@map("suppliers")
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  orderNumber    String              @unique @map("order_number")
  supplierId     String?             @map("supplier_id")
  warehouseId    String              @map("warehouse_id")
  status         PurchaseOrderStatus @default(DRAFT)
  currency       String              @default("USD")
  exchangeRate   Decimal             @default(1) @db.Decimal(14, 6) @map("exchange_rate")
  /// Actual rate once the goods arrive; landed MMK cost is rescaled from exchangeRate to this.
  receivedExchangeRate Decimal?      @db.Decimal(14, 6) @map("received_exchange_rate")
  paymentTerms   String?             @map("payment_terms")
  deliveryTerms  String?             @map("delivery_terms")
  notes          String?
  /// Free-text supplier contact captured on the order.
  supplierContact String?            @map("supplier_contact")
  /// Date the seller entered for the order.
  orderDate      DateTime?           @map("order_date")
  orderedAt      DateTime?           @map("ordered_at")
  expectedAt     DateTime?           @map("expected_at")
  subtotal       Decimal             @db.Decimal(14, 2)
  discountAmount Decimal             @default(0) @db.Decimal(14, 2) @map("discount_amount")
  taxAmount      Decimal             @default(0) @db.Decimal(14, 2) @map("tax_amount")
  shippingAmount Decimal             @default(0) @db.Decimal(14, 2) @map("shipping_amount")
  totalAmount    Decimal             @db.Decimal(14, 2) @map("total_amount")
  createdBy      String?             @map("created_by")
  /// WAREHOUSE: seller is taking stock already in the warehouse.
  /// SUPPLIER: seller is buying from a supplier so the warehouse can be restocked.
  orderKind      PurchaseOrderKind   @default(SUPPLIER) @map("order_kind")
  /// Index of the active transit leg (from routeStops[i] → routeStops[i+1]).
  routeLegIndex  Int                 @default(0) @map("route_leg_index")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  supplier        Supplier?                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items           PurchaseOrderItem[]
  receipts        PurchaseReceipt[]
  returns         PurchaseReturn[]
  statusHistory   PurchaseOrderStatusHistory[]
  deliveryStages  PurchaseDeliveryStage[]
  additionalCosts PurchaseAdditionalCost[]
  costAdjustments PurchaseCostAdjustment[]
  attachments       PurchaseOrderAttachment[]
  damageReports     DamageReport[]
  deliveryHandoffs  DeliveryHandoff[]
  routeStops        PurchaseOrderRouteStop[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status, createdAt])
  @@map("purchase_orders")
}

/// Ordered transit checkpoints for a supplier purchase (e.g. China → Lashio → Mandalay → Yangon).
model PurchaseOrderRouteStop {
  id              String    @id @default(uuid())
  purchaseOrderId String    @map("purchase_order_id")
  sequence        Int
  location        String
  arrivedAt       DateTime? @map("arrived_at")
  arrivedBy       String?   @map("arrived_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, sequence])
  @@index([purchaseOrderId])
  @@map("purchase_order_route_stops")
}

model PurchaseOrderAttachment {
  id              String   @id @default(uuid())
  purchaseOrderId String   @map("purchase_order_id")
  fileName        String   @map("file_name")
  mimeType        String   @map("mime_type")
  sizeBytes       Int      @map("size_bytes")
  content         Bytes
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_attachments")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String   @map("purchase_order_id")
  productId       String   @map("product_id")
  variantId       String   @default("") @map("variant_id")
  sku             String?
  productName     String?  @map("product_name")
  description     String?
  unit            String?
  colorId         String?  @map("color_id")
  sizeId          String?  @map("size_id")
  colorName       String?  @map("color_name")
  sizeName        String?  @map("size_name")
  length          Decimal? @db.Decimal(12, 4)
  width           Decimal? @db.Decimal(12, 4)
  height          Decimal? @db.Decimal(12, 4)
  quantity        Int
  unitCost        Decimal  @db.Decimal(12, 2) @map("unit_cost")
  discountAmount  Decimal  @default(0) @db.Decimal(14, 2) @map("discount_amount")
  weightPerUnit   Decimal  @default(0) @db.Decimal(12, 4) @map("weight_per_unit")
  volumePerUnit   Decimal  @default(0) @db.Decimal(12, 6) @map("volume_per_unit")
  receivedQty     Int      @default(0) @map("received_qty")
  acceptedQty     Int      @default(0) @map("accepted_qty")
  rejectedQty     Int      @default(0) @map("rejected_qty")
  lineTotal       Decimal  @db.Decimal(14, 2) @map("line_total")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  purchaseOrder       PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receiptItems        PurchaseReceiptItem[]
  damageItems         DamageReportItem[]
  deliveryHandoffItems DeliveryHandoffItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

/// Delivery agent confirms variation + quantity after pickup, before sending to seller.
model DeliveryHandoff {
  id              String   @id @default(uuid())
  purchaseOrderId String   @map("purchase_order_id")
  confirmedBy     String   @map("confirmed_by")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  items         DeliveryHandoffItem[]

  @@index([purchaseOrderId, createdAt])
  @@index([confirmedBy])
  @@map("delivery_handoffs")
}

model DeliveryHandoffItem {
  id                    String  @id @default(uuid())
  deliveryHandoffId     String  @map("delivery_handoff_id")
  purchaseOrderItemId   String? @map("purchase_order_item_id")
  productId             String  @map("product_id")
  variantId             String  @default("") @map("variant_id")
  productName           String? @map("product_name")
  colorName             String? @map("color_name")
  sizeName              String? @map("size_name")
  orderedQty            Int     @map("ordered_qty")
  confirmedQty          Int     @map("confirmed_qty")
  variationCorrect      Boolean @default(true) @map("variation_correct")
  notes                 String?

  deliveryHandoff   DeliveryHandoff    @relation(fields: [deliveryHandoffId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  @@index([deliveryHandoffId])
  @@map("delivery_handoff_items")
}

/// Damage found by a delivery agent when inspecting a supplier parcel.
model DamageReport {
  id              String             @id @default(uuid())
  reportNumber    String             @unique @map("report_number")
  purchaseOrderId String             @map("purchase_order_id")
  reportedBy      String             @map("reported_by")
  notes           String?
  status          DamageReportStatus @default(SUBMITTED)
  confirmedBy     String?            @map("confirmed_by")
  confirmedAt     DateTime?          @map("confirmed_at")
  stockReducedAt  DateTime?          @map("stock_reduced_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  items         DamageReportItem[]

  @@index([purchaseOrderId, createdAt])
  @@index([reportedBy])
  @@index([status])
  @@map("damage_reports")
}

model DamageReportItem {
  id                  String  @id @default(uuid())
  damageReportId      String  @map("damage_report_id")
  purchaseOrderItemId String? @map("purchase_order_item_id")
  productId           String  @map("product_id")
  variantId           String  @default("") @map("variant_id")
  productName         String? @map("product_name")
  quantity            Int
  damageType          String? @map("damage_type")
  notes               String?

  damageReport      DamageReport       @relation(fields: [damageReportId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  @@index([damageReportId])
  @@map("damage_report_items")
}

/// Goods Receipt Note (GRN). Confirming one applies stock to inventory.
model PurchaseReceipt {
  id              String                @id @default(uuid())
  receiptNumber   String                @unique @map("receipt_number")
  purchaseOrderId String                @map("purchase_order_id")
  warehouseId     String                @map("warehouse_id")
  status          PurchaseReceiptStatus @default(DRAFT)
  receivedAt      DateTime?             @map("received_at")
  createdBy       String?               @map("created_by")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items         PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@index([status])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                  String   @id @default(uuid())
  purchaseReceiptId   String   @map("purchase_receipt_id")
  purchaseOrderItemId String?  @map("purchase_order_item_id")
  productId           String   @map("product_id")
  variantId           String   @default("") @map("variant_id")
  quantity            Int
  acceptedQty         Int?     @map("accepted_qty")
  rejectedQty         Int      @default(0) @map("rejected_qty")
  unitCost            Decimal  @db.Decimal(12, 2) @map("unit_cost")
  lineTotal           Decimal  @db.Decimal(14, 2) @map("line_total")
  batchNumber         String?  @map("batch_number")
  expiryAt            DateTime? @map("expiry_at")
  createdAt           DateTime @default(now()) @map("created_at")

  purchaseReceipt   PurchaseReceipt  @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  @@index([purchaseReceiptId])
  @@index([productId])
  @@map("purchase_receipt_items")
}

model PurchaseReturn {
  id              String               @id @default(uuid())
  returnNumber    String               @unique @map("return_number")
  supplierId      String               @map("supplier_id")
  purchaseOrderId String?              @map("purchase_order_id")
  warehouseId     String               @map("warehouse_id")
  status          PurchaseReturnStatus @default(DRAFT)
  reason          String?
  returnedAt      DateTime?            @map("returned_at")
  createdBy       String?              @map("created_by")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  supplier      Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  items         PurchaseReturnItem[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String   @id @default(uuid())
  purchaseReturnId String   @map("purchase_return_id")
  productId        String   @map("product_id")
  variantId        String   @default("") @map("variant_id")
  quantity         Int
  unitCost         Decimal  @db.Decimal(12, 2) @map("unit_cost")
  lineTotal        Decimal  @db.Decimal(14, 2) @map("line_total")
  createdAt        DateTime @default(now()) @map("created_at")

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  @@index([purchaseReturnId])
  @@index([productId])
  @@map("purchase_return_items")
}

/// Immutable audit trail of purchase order status changes.
model PurchaseOrderStatusHistory {
  id              String              @id @default(uuid())
  purchaseOrderId String              @map("purchase_order_id")
  status          PurchaseOrderStatus
  note            String?
  changedBy       String?             @map("changed_by")
  createdAt       DateTime            @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId, createdAt])
  @@map("purchase_order_status_history")
}

/// Multi-stage freight legs for a purchase order (Pickup, Main Freight, Final Delivery...).
model PurchaseDeliveryStage {
  id                   String               @id @default(uuid())
  purchaseOrderId      String               @map("purchase_order_id")
  sequence             Int                  @default(1)
  name                 String
  carrier              String?
  feeAmount            Decimal              @default(0) @db.Decimal(14, 2) @map("fee_amount")
  currency             String               @default("USD")
  allocationMethod     CostAllocationMethod @default(QUANTITY) @map("allocation_method")
  applicableProductIds String[]             @default([]) @map("applicable_product_ids")
  notes                String?
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_delivery_stages")
}

/// Extra procurement expenses (handling, customs, insurance, taxes) with allocation method.
model PurchaseAdditionalCost {
  id                   String                  @id @default(uuid())
  purchaseOrderId      String                  @map("purchase_order_id")
  name                 String
  category             AdditionalCostCategory  @default(OTHER)
  amount               Decimal                 @default(0) @db.Decimal(14, 2)
  currency             String                  @default("USD")
  allocationMethod     CostAllocationMethod    @default(QUANTITY) @map("allocation_method")
  status               CostStatus              @default(ESTIMATED)
  applicableProductIds String[]                @default([]) @map("applicable_product_ids")
  notes                String?
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_additional_costs")
}

/// Late freight / invoice adjustments applied after goods arrival to finalize actual unit costs.
model PurchaseCostAdjustment {
  id               String                      @id @default(uuid())
  adjustmentNumber String                      @unique @map("adjustment_number")
  purchaseOrderId  String                      @map("purchase_order_id")
  type             PurchaseCostAdjustmentType  @default(OTHER)
  amount           Decimal                     @default(0) @db.Decimal(14, 2)
  currency         String                      @default("USD")
  allocationMethod CostAllocationMethod        @default(QUANTITY) @map("allocation_method")
  reason           String?
  isApplied        Boolean                     @default(false) @map("is_applied")
  appliedAt        DateTime?                   @map("applied_at")
  createdBy        String?                     @map("created_by")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_cost_adjustments")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  PENDING
  APPROVED
  ORDERED
  /// Goods are moving between route stops (seller tracks each leg).
  IN_TRANSIT
  /// Final route stop reached; delivery agent can pick up.
  ARRIVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
  LOW_STOCK
  RESTOCK_REQUESTED
  RESTOCK_APPROVED
  /// Delivery agent took the parcel at the final destination.
  DELIVERY_PICKED_UP
  /// Delivery agent sent the parcel to the warehouse manager.
  AWAITING_WAREHOUSE_RECEIPT
  /// @deprecated Prefer AWAITING_WAREHOUSE_RECEIPT.
  AWAITING_SELLER_RECEIPT
  /// @deprecated Prefer WAREHOUSE_RECEIVED.
  SELLER_RECEIVED
  /// Warehouse manager posted GRN; products are in the warehouse.
  WAREHOUSE_RECEIVED
}

enum DamageReportStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
}

enum PurchaseOrderKind {
  WAREHOUSE
  SUPPLIER
}

enum PurchaseReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PurchaseReturnStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// How a freight/cost amount is spread across the applicable purchase order lines.
enum CostAllocationMethod {
  QUANTITY
  WEIGHT
  VOLUME
  VALUE
  MANUAL
}

