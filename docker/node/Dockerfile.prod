# syntax=docker/dockerfile:1

########################################################
# Builder Stage
########################################################
FROM node:24-bookworm-slim AS builder

WORKDIR /var/www/html/warehouse-service

RUN apt-get update && apt-get install -y \
    openssl \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./

COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts

RUN npm install

COPY src ./src
COPY tsconfig.json ./

RUN DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy" npx prisma generate --schema=./prisma/schema.prisma

RUN npm run build


########################################################
# Production Stage
########################################################
FROM node:24-bookworm-slim

WORKDIR /var/www/html/warehouse-service

RUN apt-get update && apt-get install -y \
    openssl \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm install --omit=dev

COPY --from=builder /var/www/html/warehouse-service/dist ./dist
COPY --from=builder /var/www/html/warehouse-service/prisma ./prisma
COPY --from=builder /var/www/html/warehouse-service/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /var/www/html/warehouse-service/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /var/www/html/warehouse-service/prisma.config.ts ./prisma.config.ts

COPY docker/node/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["docker-entrypoint.sh"]

EXPOSE 5002

CMD ["node", "dist/server.js"]
