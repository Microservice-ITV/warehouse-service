# ==================================================
# Environment
# ==================================================
NODE_ENV=production
PORT=5002

APP_CONTAINER_NAME=warehouse-service
POSTGRES_CONTAINER_NAME=warehouse-service-db
POSTGRES_HOST_PORT=5440

DOCKER_IMAGE=warehouse-service
DOCKER_USERNAME=itvmicroservicesteam
IMAGE_TAG=latest

# ==================================================
# PostgreSQL
# ==================================================
POSTGRES_IMAGE=postgres:16-alpine

POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=microservicesteamwarehouse2026
POSTGRES_DB=warehouse_service_db

DATABASE_URL=postgresql://warehouse_user:microservicesteamwarehouse2026@warehouse-postgres:5432/warehouse_service_db?schema=public

RUN_MIGRATIONS=true

# ==================================================
# CORS
# ==================================================
CORS_ORIGIN=https://dailyneeditems.com

# ==================================================
# Logging
# ==================================================
LOG_LEVEL=info

# ==================================================
# Service-to-service auth
# ==================================================
SERVICE_API_KEY=a23r_sfw32wefsasfwerwe123dsafsfver

# ==================================================
# JWT
# ==================================================
JWT_SECRET=PViiSHiBlQJ7SYcR9xNJVBSK1Y3ob4k0bMB7P37TpEFKI7IFQ0rmtWLg1dj6irOB

# ==================================================
# RabbitMQ
# ==================================================
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=order_events
RABBITMQ_DLX=order_events.dlx
RABBITMQ_PREFETCH=20

RABBITMQ_PRODUCT_CREATED_KEY=product.created
RABBITMQ_PRODUCT_UPDATED_KEY=product.updated
RABBITMQ_PRODUCT_DELETED_KEY=product.deleted
RABBITMQ_SHOP_CREATED_KEY=shop.created
RABBITMQ_SHOP_UPDATED_KEY=shop.updated
RABBITMQ_SHOP_DELETED_KEY=shop.deleted

RABBITMQ_PRODUCT_CREATED_QUEUE=warehouse_service.product_created
RABBITMQ_PRODUCT_UPDATED_QUEUE=warehouse_service.product_updated
RABBITMQ_PRODUCT_DELETED_QUEUE=warehouse_service.product_deleted
RABBITMQ_SHOP_CREATED_QUEUE=warehouse_service.shop_created
RABBITMQ_SHOP_UPDATED_QUEUE=warehouse_service.shop_updated
RABBITMQ_SHOP_DELETED_QUEUE=warehouse_service.shop_deleted

RABBITMQ_PRODUCT_CREATED_DLQ=warehouse_service.product_created.dlq
RABBITMQ_PRODUCT_UPDATED_DLQ=warehouse_service.product_updated.dlq
RABBITMQ_PRODUCT_DELETED_DLQ=warehouse_service.product_deleted.dlq
RABBITMQ_SHOP_CREATED_DLQ=warehouse_service.shop_created.dlq
RABBITMQ_SHOP_UPDATED_DLQ=warehouse_service.shop_updated.dlq
RABBITMQ_SHOP_DELETED_DLQ=warehouse_service.shop_deleted.dlq

RABBITMQ_INVENTORY_UPDATED_KEY=inventory.updated
RABBITMQ_INVENTORY_LOW_STOCK_KEY=inventory.low_stock

# Low stock alert: publish inventory.low_stock when available stock < threshold
LOW_STOCK_THRESHOLD=5

# Outbox
OUTBOX_PUBLISH_INTERVAL_MS=5000
OUTBOX_PUBLISH_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=20
